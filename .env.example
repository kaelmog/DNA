# Copy this file to .env.local for local development and fill in the values.
# On Vercel, add the same variables under Project -> Settings -> Environment Variables
# (Production and Preview), then redeploy. Never commit real secrets: .env*.local is git-ignored.
#
# REQUIRED to run the shop: NEXT_PUBLIC_SITE_URL and the three Supabase variables.
# OPTIONAL: Stripe (without it the shop takes manual payments) and Resend (email).
# Without any variables at all the site still starts in demo mode with sample products.
# The /todo page shows which variables are set and walks through every step.

# --- Site (required) --------------------------------------------------------
# Public URL of the site, without a trailing slash. Used for SEO, emails and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ----------------------------------------------------
# Project URL: Supabase -> Project Settings -> Data API (or the Connect button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys. The publishable key (sb_publishable_...);
# the legacy "anon" key also works. Public by design: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. The secret key (sb_secret_...) or legacy service_role key, same page.
# Needed for checkout, public forms and rate limiting. It bypasses Row Level Security,
# so never expose it to the browser, commit it or paste it anywhere public.
SUPABASE_SECRET_KEY=

# --- Stripe (optional) ------------------------------------------------------
# Leave both empty to take manual payments: orders arrive as "Awaiting payment" and you
# mark them paid in Admin -> Orders. Setting STRIPE_SECRET_KEY switches checkout to Stripe
# automatically, so add the webhook secret at the same time.
# SERVER ONLY. Stripe -> Developers -> API keys. sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=
# SERVER ONLY. Signing secret (whsec_...) of the webhook pointing to /api/webhooks/stripe.
# Required as soon as STRIPE_SECRET_KEY is set, or paid orders are never marked as paid.
STRIPE_WEBHOOK_SECRET=

# --- Email via Resend (optional, recommended) -------------------------------
# Without RESEND_API_KEY and EMAIL_FROM the shop sends no emails of its own (order received,
# payment confirmed, shipped, admin notifications). Supabase auth emails are separate.
# SERVER ONLY. Resend -> API Keys (Sending access).
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Knotted Studio <orders@yourdomain.com>".
EMAIL_FROM=
# Where new-order, custom-request and contact-form notifications are sent.
ADMIN_NOTIFICATION_EMAIL=
